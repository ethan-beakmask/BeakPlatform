# BeakPlatform 環境變數範例
# 複製此檔案為 .env 並修改設定值
# WARNING: .env 不應該提交到版本控制

# ============================================================
# 資料庫設定
# ============================================================
DB_PASSWORD=your_password_here
DB_PORT=5432
DATABASE_URL=postgresql://beakplatform:your_password_here@localhost:5432/beakplatform_dev

# ============================================================
# Redis 設定 (可選，用於快取和 Rate Limiting)
# ============================================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ============================================================
# 初始管理員密碼 (首次安裝時必填，初始化完成後可移除)
# ============================================================
ADMIN_INITIAL_PASSWORD=change-this-to-your-admin-password

# ============================================================
# 應用程式設定
# ============================================================
APP_PORT=7000
SECRET_KEY=change-this-to-a-long-random-string

# ============================================================
# Flask 設定
# ============================================================
# development / production
FLASK_ENV=development
FLASK_DEBUG=1

# ============================================================
# 開發工具設定 (僅開發環境)
# ============================================================
# 啟用開發工具快速登入
ENABLE_DEV_TOOLS=true
# 允許存取開發工具的 IP 範圍
DEV_ALLOWED_IPS=127.0.0.1,192.168.0.0/16,10.0.0.0/8

# ============================================================
# Rate Limiting 設定
# ============================================================
RATELIMIT_ENABLED=false
RATELIMIT_DEFAULT="200 per day;50 per hour"
RATELIMIT_LOGIN="30 per minute"
RATELIMIT_FORGOT_PASSWORD="3 per hour"
RATELIMIT_RESET_PASSWORD="5 per hour"

# ============================================================
# Nginx 設定 (生產環境)
# ============================================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ============================================================
# 企業專屬資料庫 Provisioning
# ============================================================
# PostgreSQL 管理員連線 URL（需有 CREATEDB + CREATEROLE 權限）
SYNC_PG_ADMIN_URL=postgresql://postgres:your_password_here@localhost/postgres

# Org Database Credential Encryption (Fernet key, 用 python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 產生)
SYNC_CREDENTIAL_KEY=your_fernet_key_here
