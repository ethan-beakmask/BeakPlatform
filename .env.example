# BeakPlatform 環境變數範例
# 複製此檔案為 .env 並修改設定值
# WARNING: .env 不應該提交到版本控制

# ============================================================
# 資料庫設定
# ============================================================
DB_PASSWORD=your_password_here
DB_PORT=5432
DATABASE_URL=postgresql://beakplatform:your_password_here@localhost:5432/beakplatform_dev

# ============================================================
# Redis 設定 (可選，用於快取和 Rate Limiting)
# ============================================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ============================================================
# 初始管理員密碼 (首次安裝時必填，初始化完成後可移除)
# ============================================================
ADMIN_INITIAL_PASSWORD=change-this-to-your-admin-password

# ============================================================
# 應用程式設定
# ============================================================
APP_PORT=8000
SECRET_KEY=change-this-to-a-long-random-string

# ============================================================
# Flask 設定
# ============================================================
# development / production
FLASK_ENV=development
FLASK_DEBUG=1

# ============================================================
# 開發工具設定 (僅開發環境)
# ============================================================
# 啟用開發工具快速登入
ENABLE_DEV_TOOLS=true
# 允許存取開發工具的 IP 範圍
DEV_ALLOWED_IPS=127.0.0.1,192.168.0.0/16,10.0.0.0/8

# ============================================================
# Rate Limiting 設定
# ============================================================
RATELIMIT_ENABLED=false
RATELIMIT_DEFAULT="200 per day;50 per hour"
RATELIMIT_LOGIN="30 per minute"
RATELIMIT_FORGOT_PASSWORD="3 per hour"
RATELIMIT_RESET_PASSWORD="5 per hour"

# ============================================================
# Nginx 設定 (生產環境)
# ============================================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ============================================================
# 企業專屬資料庫 Provisioning
# ============================================================
# PostgreSQL 管理員連線 URL（需有 CREATEDB + CREATEROLE 權限）
SYNC_PG_ADMIN_URL=postgresql://postgres:your_password_here@localhost/postgres

# Org Database Credential Encryption (Fernet key, 用 python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 產生)
SYNC_CREDENTIAL_KEY=your_fernet_key_here

# 檔案加密 (FILE-01) - AES-256-GCM
# 產生方式: python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 注意: 遺失 Master Key 將無法解密既有加密附件
ENCRYPTION_MASTER_KEY=
ENCRYPTED_STORAGE_DIR=/opt/BeakPlatform/backend/encrypted_storage

# ============================================================
# OpenDefense 外部查詢 (.20 sec-vm)
# ============================================================
OD_BRIDGE_URL=http://192.168.0.20:8500
# OpenDefense 平台端 EDL（防火牆黑名單）輸出目錄，未設定時預設 <repo>/data/edl
OD_EDL_OUTPUT_DIR=
# 允許抓取 EDL 的來源 IP／網段（逗號分隔）。未設定＝一律拒絕（fail-closed）
OD_EDL_ALLOWED_IPS=

# ============================================================
# AI 分析節點（AiAgent，選用）
# ============================================================
# 流程設計器的「AI 分析」節點會呼叫本機的 Claude Code CLI。
# 沒有用到這個節點時整段可以不管。
#
# 建議一律填絕對路徑：節點由背景的流程執行器（systemd 服務）執行，
# 而服務的 PATH 與登入 shell 不同，常見情況是找不到 CLI，
# 或找到另一份不支援 --safe-mode 的舊版而每次執行都失敗。
# 用 `which claude` 取得實際路徑。
#
# 完整需求（認證放哪個帳號的家目錄、代理與內部憑證、錯誤訊息對照）：
#   docs/install/ai_node.md
# AI_NODE_CLI_PATH=/usr/local/bin/claude

# --- OsExecutor / OS 命令節點（預設關閉，見 docs/install/os_node.md）---
# 啟用後仍需把企業加入系統設定 os_node_allowed_orgs 才能執行
# OS_NODE_ENABLED=1
# 同一企業同時執行中的 OsExecutor 節點數上限（預設 3）
# OS_NODE_MAX_CONCURRENT_PER_ORG=3

# --- FileRead / 檔案讀取節點（預設關閉，與 OsExecutor 的開關刻意獨立）---
# 啟用後仍需設定 file_read_allowed_orgs 與 file_read_base_dirs 才能讀到任何檔案
# FILE_READ_NODE_ENABLED=1
