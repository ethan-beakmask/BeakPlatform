# ITHome2026-WAF 熱備切換組態（bash 語法，KEY=VALUE）。
# 複製成 failover.conf 放在 failover.sh 旁邊（或 /etc/ithome2026-waf/failover.conf），
# failover.conf 含內網 IP，不要進版控。

SERVICE_IP="192.168.1.20"          # 只綁在現役節點的服務 IP（被保護網站與管制端只放行它）

NODE_A="192.168.1.11"              # 節點 A 的管理 IP（固定 IP）
NODE_A_NAME="primary"              # 給 `failover.sh to primary` 用的名稱，隨意取
NODE_B="192.168.1.12"              # 節點 B 的管理 IP
NODE_B_NAME="standby"

SSH_USER="ubuntu"                  # 兩台防禦端的 SSH 帳號（要能 sudo -n）
SSH_OPTS_STR="-i ~/.ssh/waf-node"  # 額外的 ssh 參數；~/ 會自動展開
INSTALL_DIR="/opt/ithome2026-waf"  # 防禦端的安裝目錄
LOG_DIR="/var/log/ithome2026-waf"  # 每次切換的輸出落地目錄（空字串＝不落地）
