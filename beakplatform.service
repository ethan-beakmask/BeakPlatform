[Unit]
Description=BeakPlatform - Multi-tenant Platform
After=network.target postgresql.service redis.service
Wants=postgresql.service

[Service]
Type=simple
User=ethan
Group=ethan
WorkingDirectory=/opt/BeakPlatform/backend
Environment="PATH=/opt/BeakPlatform/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/BeakPlatform/.env
ExecStart=/opt/BeakPlatform/venv/bin/flask run --host=0.0.0.0 --port=5009
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
