# BeakPlatform Environment Configuration
# Copy this file to .env.production and modify as needed:
#   cp .env.example .env.production

# --- Database ---
DB_PASSWORD=changeme_db_password
DATABASE_URL=postgresql://beakplatform:${DB_PASSWORD}@db:5432/beakplatform_dev

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Admin Account ---
# Optional: Set initial admin password for first-time setup.
# If not set, a random password will be generated and printed to the console.
# ADMIN_INITIAL_PASSWORD=YourSecurePassword123

# --- Application ---
# SECRET_KEY is used for session signing. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_random_secret_key
FLASK_ENV=production
FLASK_DEBUG=0

# --- Dev Tools ---
ENABLE_DEV_TOOLS=false

# --- Gunicorn ---
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# --- Session ---
SESSION_COOKIE_SECURE=false

# --- Rate Limiting ---
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_LOGIN=30 per minute

# --- Form Data Sync ---
FORMDATA_DATABASE_URL=postgresql://beakplatform:${DB_PASSWORD}@db:5432/beakform_data
