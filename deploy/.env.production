# BeakPlatform Production Environment (Docker)
# This file is used by docker-compose

# Database (container name as host)
DB_PASSWORD=postgres123
DATABASE_URL=postgresql://beakplatform:postgres123@db:5432/beakplatform_dev

# Redis (container name as host)
REDIS_URL=redis://redis:6379/0

# Application
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-STRING-IN-PRODUCTION
FLASK_ENV=production
FLASK_DEBUG=0

# Gunicorn
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# Session cookie (no SSL in staging)
SESSION_COOKIE_SECURE=false

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_LOGIN=30 per minute

# Form Data Sync
FORMDATA_DATABASE_URL=postgresql://beakplatform:postgres123@db:5432/beakform_data
