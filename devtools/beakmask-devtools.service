[Unit]
Description=BeakMask DevTools (Development Only)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ethan
Group=ethan
WorkingDirectory=/opt/BeakMask/devtools
EnvironmentFile=/opt/BeakMask/.env
Environment="PATH=/opt/BeakMask/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/BeakMask/venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
