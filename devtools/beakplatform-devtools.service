[Unit]
Description=BeakPlatform DevTools (Development Only)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ethan
Group=ethan
WorkingDirectory=/opt/BeakPlatform/devtools
EnvironmentFile=/opt/BeakPlatform/.env
Environment="PATH=/opt/BeakPlatform/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/BeakPlatform/venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
