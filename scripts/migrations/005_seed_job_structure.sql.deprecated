-- ============================================================
-- 驗證資料
-- ============================================================
DO $$
DECLARE
    level_count INTEGER;
    family_count INTEGER;
    title_count INTEGER;
BEGIN
    SELECT COUNT(*) INTO level_count FROM job_levels WHERE org_secure_code = 'org_default_00000000001' AND is_deleted = FALSE;
    SELECT COUNT(*) INTO family_count FROM job_families WHERE org_secure_code = 'org_default_00000000001' AND is_deleted = FALSE;
    SELECT COUNT(*) INTO title_count FROM job_titles WHERE org_secure_code = 'org_default_00000000001' AND is_deleted = FALSE;

    RAISE NOTICE 'Seed 完成: % 職等, % 職系, % 職稱', level_count, family_count, title_count;
END $$;
