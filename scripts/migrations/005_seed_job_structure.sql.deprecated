-- Migration: 005_seed_job_structure
-- Description: 建立預設職等、職系、職稱資料
-- Date: 2024-12-20
--
-- 此腳本為各企業建立標準的 HR 結構基礎資料
-- 使用 org_default_00000000001 作為預設企業

-- ============================================================
-- 1. 建立預設職等 (Job Levels)
-- ============================================================
-- 使用等距跳號：L000, L100, L200, ... L900

INSERT INTO job_levels (
    secure_code, org_secure_code, code, name, name_en, level_order,
    approval_limit, approval_currency, is_manager_level, management_scope,
    sort_order, is_system_default, is_active
) VALUES
    -- L900 - 總經理級 (無簽核上限)
    ('jl_l900_default_0001', 'org_default_00000000001', 'L900', '總經理級', 'President Level', 900,
     NULL, 'TWD', TRUE, '全公司', 10, TRUE, TRUE),

    -- L800 - 副總經理級 (5000萬)
    ('jl_l800_default_0001', 'org_default_00000000001', 'L800', '副總經理級', 'Vice President Level', 800,
     50000000, 'TWD', TRUE, '多處室/事業部', 20, TRUE, TRUE),

    -- L700 - 處長級 (1000萬)
    ('jl_l700_default_0001', 'org_default_00000000001', 'L700', '處長級', 'Director Level', 700,
     10000000, 'TWD', TRUE, '單一處室', 30, TRUE, TRUE),

    -- L600 - 副處長級 (500萬)
    ('jl_l600_default_0001', 'org_default_00000000001', 'L600', '副處長級', 'Deputy Director Level', 600,
     5000000, 'TWD', TRUE, '協助處室管理', 40, TRUE, TRUE),

    -- L500 - 經理級 (100萬)
    ('jl_l500_default_0001', 'org_default_00000000001', 'L500', '經理級', 'Manager Level', 500,
     1000000, 'TWD', TRUE, '單一部門', 50, TRUE, TRUE),

    -- L400 - 副理級 (50萬)
    ('jl_l400_default_0001', 'org_default_00000000001', 'L400', '副理級', 'Assistant Manager Level', 400,
     500000, 'TWD', TRUE, '協助部門管理', 60, TRUE, TRUE),

    -- L300 - 主任級 (10萬)
    ('jl_l300_default_0001', 'org_default_00000000001', 'L300', '主任級', 'Supervisor Level', 300,
     100000, 'TWD', TRUE, '小組/專案', 70, TRUE, TRUE),

    -- L200 - 高級職員級 (5萬)
    ('jl_l200_default_0001', 'org_default_00000000001', 'L200', '高級職員級', 'Senior Staff Level', 200,
     50000, 'TWD', FALSE, NULL, 80, TRUE, TRUE),

    -- L100 - 職員級 (1萬)
    ('jl_l100_default_0001', 'org_default_00000000001', 'L100', '職員級', 'Staff Level', 100,
     10000, 'TWD', FALSE, NULL, 90, TRUE, TRUE),

    -- L000 - 外部人員 (無簽核權限)
    ('jl_l000_default_0001', 'org_default_00000000001', 'L000', '外部人員', 'External', 0,
     0, 'TWD', FALSE, NULL, 100, TRUE, TRUE)

ON CONFLICT (org_secure_code, code) WHERE is_deleted = FALSE DO NOTHING;

