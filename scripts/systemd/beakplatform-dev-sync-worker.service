# /etc/systemd/system/beakplatform-dev-sync-worker.service
# =============================================================================
# BeakPlatform-Dev SQL Sync Worker
# =============================================================================
# 開發環境專用的 SQL Sync Worker。
# 把 fw_sync_queue 中的待處理項目 UPSERT 到企業專屬資料庫（org_<org_id>）。
#
# ** 開發工具 -- 僅限本機開發環境使用 **
# ** 禁止複製到正式環境或推送到 GitHub **
#
# 正式環境使用 scripts/beakplatform-sync-worker.service（路徑 /opt/BeakPlatform/）
# 開發環境使用本檔案（路徑 /opt/BeakPlatform-dev/）
# 兩者連接不同 DB，互不干擾。
#
# 前提：.env 需有 SYNC_CREDENTIAL_KEY（企業 DB 帳密的 Fernet 金鑰）。
# 注意：只有配對（fw_form_workflow_mappings）的 sql_sync_enabled=true 才會
#       產生 queue 項目，該欄位預設 false，所以 worker 起來後可能完全沒事做，
#       那是預期狀態、不是故障。
#
# 安裝：
#   sudo cp scripts/systemd/beakplatform-dev-sync-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now beakplatform-dev-sync-worker
#
# 檢查：
#   sudo systemctl status beakplatform-dev-sync-worker
#   sudo journalctl -u beakplatform-dev-sync-worker -f
# =============================================================================

[Unit]
Description=BeakPlatform-Dev SQL Sync Worker (開發環境)
After=network.target postgresql.service beakplatform-dev.service
Wants=beakplatform-dev.service

[Service]
Type=simple
User=ethan
Group=ethan
WorkingDirectory=/opt/BeakPlatform-dev/backend
Environment=PATH=/opt/BeakPlatform-dev/venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/opt/BeakPlatform-dev/.env
ExecStart=/opt/BeakPlatform-dev/venv/bin/python /opt/BeakPlatform-dev/scripts/sync_worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
