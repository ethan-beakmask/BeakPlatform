[Unit]
Description=BeakPlatform - SQL Sync Credential Rotation
After=postgresql.service

[Service]
Type=oneshot
User=ethan
WorkingDirectory=/opt/BeakPlatform
ExecStart=/bin/bash -c 'source venv/bin/activate && set -a && source .env && set +a && python scripts/rotate_credentials.py'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
