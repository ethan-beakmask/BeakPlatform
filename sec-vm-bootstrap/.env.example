# ============================================================
# Open Defense Stack — sample config
# ============================================================
# Copy to .env and fill in real values.  Do NOT commit .env.
# ============================================================

# --- BeakPlatform integration ---
# Where BeakPlatform serves its API (nginx prefix /beakplatform required)
BEAK_BASE_URL=http://192.168.0.16:7000/beakplatform
INTAKE_URL=${BEAK_BASE_URL}/api/open_defense/intake
SA_LOGIN_URL=${BEAK_BASE_URL}/api/open_defense/sa/login
DECISIONS_URL=${BEAK_BASE_URL}/api/open_defense/decisions

# Apply for an Intake Key (contract §3.1) — request from BP admin.
# Secret is base64url-encoded 32-byte HMAC key (shown ONCE on creation).
INTAKE_KEY_ID=
INTAKE_SECRET_B64=

# Apply for a Service Account (contract §3.2) — request from BP admin.
# Empty SA_ID disables the executor (you can still ingest).
SA_ID=
SA_SECRET=

# --- od-bridge runtime ---
APPLIED_BY=od-bridge@sec-vm
# Comma-separated EPs that this bridge will execute.  Decisions
# tagged with EPs not in this list are silently skipped.
MY_ENFORCEMENT_POINTS=crowdsec,nftables,cloudflare
POLL_INTERVAL=5
INGEST_LISTEN=0.0.0.0:8500

# --- ClickHouse ---
CLICKHOUSE_DB=secstack
CLICKHOUSE_USER=secstack
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse_strong_password

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_strong_password

# --- Cloudflare Tunnel (connector token, run-only) ---
# Cloudflare Dashboard → Zero Trust → Networks → Tunnels → Create a tunnel
# Copy the token from the "Install and run a connector" page.
CLOUDFLARE_TUNNEL_TOKEN=

# --- CrowdSec (LAPI URL inside the docker network) ---
CROWDSEC_LAPI_URL=http://crowdsec:8080
