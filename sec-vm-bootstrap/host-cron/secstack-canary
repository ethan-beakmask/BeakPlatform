#!/usr/bin/env bash
# /etc/cron.hourly/secstack-canary
#
# OpenDefense 合成演習（synthetic canary）：每小時對兩條偵測路徑各打一次
# 「一定會觸發」的攻擊，讓 .16 的 od_canary_check.py 檢查案件有沒有如期出現。
#
# 為什麼需要：2026-05-13 ~ 08-08 管線斷流三個月，期間 Vector health=true、
# 7 個容器全綠、Grafana 照常畫圖——所有「程式有在跑」的指標都是綠的，
# 唯一能戳破的只有「該出現的案件沒出現」。heartbeat 檔案防不了這種斷流。
#
# 兩條路徑必須分開打，因為它們會各自獨立壞掉：
#   5/13 斷的是 Suricata 容器，8/8 修的是 Vector 的 intake_filter。
#
# 【路徑 B 的坑】Suricata 監聽 ens18 且 HOME_NET 含 192.168.0.0/16，
# 打 127.0.0.1 或打 .16 都不會觸發任何規則。必須是 HOME_NET -> EXTERNAL_NET
# 的出站流量才行，所以用對外的 HTTP 請求觸發 ET HUNTING 規則 sid 2013224。
#
# 【canary 的辨識方式】固定用 TEST-NET-3 的 203.0.113.1 當來源 IP。
# SOC 看板與報表要排除這個 IP，否則每天會多 24 張演習單。

set -uo pipefail

LOG=/opt/tmp/sec-vm-canary.log
CANARY_IP=203.0.113.1
WAF_ENDPOINT="http://127.0.0.1:8080/?id=1%27%20OR%201=1--"
OUTBOUND_ENDPOINT="http://example.com/"

mkdir -p "$(dirname "$LOG")" 2>/dev/null
log() { echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') $*" >> "$LOG"; }

rc=0

# --- 路徑 A：Coraza / WAF（預期 HTTP 403，CRS 942100 SQLi）---
code_a=$(curl -s -o /dev/null -w '%{http_code}' -m 10 \
  -H "Host: beakmask.org" \
  -H "Cf-Connecting-Ip: $CANARY_IP" \
  -H "Cf-Ipcountry: ZZ" \
  -A "OD-Canary/1.0 (synthetic-waf-probe)" \
  "$WAF_ENDPOINT" 2>/dev/null)
if [[ "$code_a" == "403" ]]; then
  log "PATH_A coraza ok (HTTP $code_a)"
else
  log "PATH_A coraza UNEXPECTED (HTTP ${code_a:-none}) — WAF 沒擋下 canary，規則或容器可能有問題"
  rc=1
fi

# --- 路徑 B：Suricata（出站，預期觸發 sid 2013224 ET HUNTING UA 含 .exe）---
if curl -s -o /dev/null -m 10 -A "Mozilla/5.0 od-canary.exe" "$OUTBOUND_ENDPOINT" 2>/dev/null; then
  log "PATH_B suricata probe sent"
else
  log "PATH_B suricata probe FAILED — 對外連線不通，本次無法驗證 IDS 路徑"
  rc=1
fi

if [[ $rc -eq 0 ]]; then
  log "OK"
  mkdir -p /opt/tmp/heartbeat 2>/dev/null
  date -u '+%Y-%m-%dT%H:%M:%SZ' > /opt/tmp/heartbeat/secstack-canary
else
  log "ERROR rc=$rc"
fi
exit $rc
